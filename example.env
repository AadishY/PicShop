# This file contains the environment variables needed to run the application.
#
# To get a Gemini API key, visit https://aistudio.google.com/app/apikey
#
# Once you have your API key, you can either:
# 1. Rename this file to .env.local and replace YOUR_API_KEY with your actual key.
# 2. Set the VITE_GEMINI_API_KEY environment variable in your shell.
#
VITE_GEMINI_API_KEY=YOUR_API_KEY
